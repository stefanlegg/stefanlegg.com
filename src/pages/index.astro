---
import { getCollection } from "astro:content";

import PostCard from "@/components/PostCard.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import Layout from "@/layouts/Layout.astro";

import work from "@/data/work";

const posts = (await getCollection("posts", ({ data }) => !data.isDraft)).sort(
	(first, second) => second.data.publishedAt.getTime() - first.data.publishedAt.getTime(),
);

const companies = [...new Set(work.map((w) => w.company))];
const grouped = companies.map((company) => ({
	company,
	items: work.filter((w) => w.company === company),
}));
---

<Layout>
  <div class="hero">
    <h1 class="hero-name"><strong>Stefan</strong> Legg</h1>
    <div class="hero-role">Software Engineer</div>
    <div class="hero-sub">15+ years building for the web &mdash; currently at <a href="https://shopify.com" target="_blank" rel="noopener" class="shopify-link">Shopify</a></div>
  </div>

  <div class="section">
    <h2 class="section-label">About</h2>
    <div class="section-text">
      I've been building for the web for <strong>over 15 years</strong> — everything from scrappy experiments to tools used by <strong>millions around the world</strong>. These days, I'm focused on React, TypeScript, and making commerce better for everyone.
    </div>
  </div>

  <div class="section">
    <h2 class="section-label">Work</h2>
    <div class="changelog">
      {grouped.map((group) => (
        <div class="changelog-group">
          <div class="changelog-company">
            <span class="changelog-company-text">{group.company}</span>
          </div>
          <div class="changelog-entries">
            {group.items.map((item) => (
              <a href={item.link} target="_blank" rel="noopener noreferrer" class="changelog-entry">
                <div class="changelog-title-row">
                  <span class="changelog-name">{item.title}</span>
                  <span class="changelog-arrow">&nearr;</span>
                </div>
                <p class="changelog-desc">{item.description}</p>
                <span class="changelog-techs">{item.techs.join(" · ")}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  {posts.length > 0 && (
    <div class="section">
      <h2 class="section-label">Writing</h2>
      {posts.slice(0, 1).map((post) => (
        <PostCard
          publishedAt={post.data.publishedAt}
          title={post.data.title}
          description={post.data.description}
          slug={post.slug}
          contentType="posts"
        />
      ))}
    </div>
  )}

  <div class="section">
    <h2 class="section-label">Connect</h2>
    <SocialLinks />
  </div>

  <div class="footer">
    <span>&copy; 2026 Stefan Legg</span>
    <button id="footer-clock" type="button" class="footer-clock" aria-label="Mission elapsed time" aria-pressed="false" title="Show time spent exploring" disabled>—:—:— UTC</button>
  </div>
</Layout>

<script>
  import { formatElapsed, formatUTC, getVisitStart } from '@/lib/visit-clock';

  let showElapsed = false;

  function initFooterClock() {
    const el = document.getElementById('footer-clock') as HTMLButtonElement | null;
    if (!el) return;
    const startedAt = getVisitStart();
    const controller = new AbortController();
    const render = () => {
      el.textContent = showElapsed ? formatElapsed(startedAt) : formatUTC(new Date());
      el.setAttribute('aria-pressed', String(showElapsed));
      el.title = showElapsed ? 'Show UTC time' : 'Show time spent exploring';
    };
    render();
    el.disabled = false;
    el.addEventListener('click', () => {
      showElapsed = !showElapsed;
      render();
    }, { signal: controller.signal });
    const interval = setInterval(render, 1000);
    document.addEventListener('astro:before-swap', () => {
      clearInterval(interval);
      controller.abort();
    }, { once: true, signal: controller.signal });
  }
  document.addEventListener('astro:page-load', initFooterClock);
</script>

<style>
  .hero {
    padding: 56px 0 48px;
    animation: hero-enter 240ms var(--ease-out) both;
  }
  @keyframes hero-enter {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes hero-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero {
      animation-name: hero-fade;
      /* Keep a gentle fade instead of the global instant-animation fallback. */
      animation-duration: 120ms !important;
    }
  }
  .hero-name {
    font-family: var(--font-body);
    font-size: clamp(48px, 12vw, 76px);
    font-weight: 200; line-height: 1.0;
    color: var(--text); letter-spacing: -0.5px;
    text-shadow: 0 0 40px rgba(160, 128, 196, 0.18);
  }
  .hero-name :global(strong) { font-weight: 600; }
  .hero-role {
    font-family: var(--font-mono); font-size: 16px; font-weight: 400;
    letter-spacing: 4px; text-transform: uppercase;
    color: var(--accent); margin-top: 18px;
    text-shadow: 0 0 12px var(--accent-glow);
  }
  .hero-sub {
    font-family: var(--font-mono); font-size: 14px;
    color: var(--text-label); margin-top: 10px;
    letter-spacing: 1px;
  }
  .shopify-link {
    color: var(--text-label);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .shopify-link:hover { color: #8bba6a; }

  .section {
    padding: 48px 0;
  }
  .section-label {
    font-family: var(--font-mono); font-size: 14px; font-weight: 500;
    letter-spacing: 4px; text-transform: uppercase;
    color: var(--text-label); margin-bottom: 24px;
    display: flex; align-items: center; gap: 12px;
  }
  .section-label::after {
    content: ''; flex: 1; height: 1px; background: var(--text-rule);
  }
  .section-text {
    font-size: 24px; font-weight: 300; line-height: 1.85;
    color: var(--text-body);
  }
  .section-text :global(strong) { color: var(--text-strong); font-weight: 500; }

  .changelog { display: flex; flex-direction: column; gap: 0; }

  .changelog-group { }
  .changelog-group + .changelog-group { margin-top: 32px; }

  .changelog-company {
    display: flex; align-items: center; gap: 12px;
    margin-bottom: 16px;
  }
  .changelog-company-text {
    font-family: var(--font-mono); font-size: 12px; font-weight: 500;
    letter-spacing: 3px; text-transform: uppercase;
    color: var(--accent); white-space: nowrap;
  }
  .changelog-company::after {
    content: ''; flex: 1; height: 1px;
    background: linear-gradient(90deg, var(--accent), transparent 80%);
    opacity: 0.3;
  }

  .changelog-entries {
    border-left: 2px solid var(--text-rule);
    padding-left: 24px;
    display: flex; flex-direction: column;
  }

  .changelog-entry {
    display: flex; flex-direction: column; gap: 8px;
    padding: 18px 0;
    text-decoration: none; color: inherit;
    position: relative;
  }
  .changelog-entry + .changelog-entry {
    border-top: 1px solid rgba(208, 216, 234, 0.05);
  }
  .changelog-entry:focus-visible .changelog-name { color: var(--accent-bright); }
  .changelog-entry:focus-visible .changelog-arrow { color: var(--accent-bright); }

  /* accent bar glow on hover */
  .changelog-entries {
    transition: border-color 0.3s;
  }

  .changelog-title-row {
    display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
  }

  .changelog-name {
    font-size: 24px; font-weight: 500; color: var(--text);
    transition: color 160ms ease;
  }

  .changelog-arrow {
    font-size: 15px; color: var(--text-muted);
    transition: color 160ms ease, transform 160ms var(--ease-out);
    flex-shrink: 0;
  }
  @media (hover: hover) and (pointer: fine) {
    .changelog-entry:hover .changelog-name { color: var(--accent-bright); }
    .changelog-entry:hover .changelog-arrow {
      color: var(--accent-bright);
      transform: translate(2px, -2px);
    }
  }

  .changelog-desc {
    font-size: 19px; font-weight: 300; line-height: 1.7;
    color: var(--text-body);
  }

  .changelog-techs {
    font-family: var(--font-mono); font-size: 14px;
    color: var(--text-label); letter-spacing: 0.5px;
  }

  .footer {
    padding: 28px 0 40px;
    display: flex; justify-content: space-between; align-items: center;
    font-family: var(--font-mono); font-size: 13px; font-weight: 400;
    letter-spacing: 3px; text-transform: uppercase; color: var(--text-muted);
  }

  .footer-clock {
    width: 24ch;
    min-height: 44px;
    padding: 8px 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-variant-numeric: tabular-nums;
    letter-spacing: 1px;
    text-transform: none;
    text-align: right;
    white-space: nowrap;
    cursor: pointer;
    transition: color 160ms ease;
  }
  .footer-clock:disabled { cursor: default; }
  .footer-clock:focus-visible {
    outline: 2px solid var(--accent-bright);
    outline-offset: 4px;
    border-radius: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .footer-clock:hover { color: var(--accent-bright); }
  }

  @media (max-width: 600px) {
    .hero { padding: 40px 0 36px; }
    .hero-name { font-size: clamp(44px, 12vw, 48px); }
    .changelog-entries { padding-left: 16px; }
    .changelog-name { font-size: 20px; }
    .footer { flex-direction: column; gap: 6px; text-align: center; }
    .footer-clock { align-self: center; text-align: center; }
  }
</style>
