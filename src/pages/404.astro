---
import Layout from "@/layouts/Layout.astro";
import StrandedSatellite from "@/components/StrandedSatellite.astro";
---

<Layout
  title="Lost in orbit — Stefan Legg"
  description="This page has drifted out of range. Let's get you back to mission control."
  noindex
>
  <section class="lost-orbit" aria-labelledby="lost-title">
    <div class="lost-copy">
      <p class="lost-status">404 · Off course</p>
      <h1 id="lost-title">Lost in orbit.</h1>
      <p class="lost-description">
        This page has drifted out of range.
      </p>
      <a class="return-home" href="/" aria-label="Return to Earth — home">
        <span aria-hidden="true">←</span> Return to Earth
      </a>
    </div>

    <StrandedSatellite />
  </section>
</Layout>

<style>
  .lost-orbit {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 520px;
    margin: 24px 0 32px;
    perspective: 1000px;
    transform-style: preserve-3d;
    pointer-events: none;
  }

  .lost-copy {
    position: relative;
    width: min(100% - 180px, 420px);
    text-align: center;
    transform: translateZ(0);
    pointer-events: auto;
    /* A soft, opaque center lets the far side slip behind the copy. */
    background: radial-gradient(ellipse, rgba(8, 9, 14, 0.96) 30%, rgba(8, 9, 14, 0.7) 55%, transparent 75%);
  }

  .lost-status {
    margin-bottom: 20px;
    color: var(--accent-bright);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  h1 {
    color: var(--text);
    font-size: clamp(44px, 7vw, 64px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.5px;
  }

  .lost-description {
    margin: 24px 0 32px;
    color: var(--text-body);
    font-size: 22px;
    font-weight: 300;
    line-height: 1.7;
  }

  .return-home {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 10px 18px;
    border: 1px solid var(--accent);
    border-radius: 4px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 14px;
    text-decoration: none;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .return-home:active { background-color: var(--accent-glow); }

  @media (hover: hover) and (pointer: fine) {
    .return-home:hover {
      border-color: var(--accent-bright);
      background-color: var(--accent-glow);
    }
  }

  @media (max-width: 600px) {
    .lost-orbit {
      min-height: 480px;
      margin: 8px 0 24px;
    }
    .lost-copy {
      width: min(100% - 32px, 340px);
    }
    h1 { font-size: clamp(32px, 8vw, 44px); }
    .lost-status { margin-bottom: 16px; }
    .lost-description { margin: 20px 0 24px; font-size: 18px; line-height: 1.6; }
    .return-home { padding: 10px 12px; font-size: 12px; }
  }
</style>
